# Imagen de PRODUCCION del frontend.
#
# A diferencia del Dockerfile de desarrollo (que corre `npm run dev`, el servidor
# de Vite), aqui se COMPILA la SPA a archivos estaticos y se sirven con nginx.
# El servidor de dev de Vite no es para produccion: lento, sin optimizar y no
# pensado para exponerse.
#
# Multi-etapa: la primera compila (necesita Node); la segunda solo lleva nginx +
# los estaticos, asi la imagen final es minima.

FROM node:20-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .
# El frontend llama a la API por ruta relativa (/api), asi que NO hace falta
# ninguna variable en tiempo de build: nginx proxya /api al backend.
RUN npm run build          # genera /app/dist

FROM nginx:alpine
# Config propia: sirve la SPA y reenvia /api al backend (ver nginx-spa.conf).
COPY nginx-spa.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
